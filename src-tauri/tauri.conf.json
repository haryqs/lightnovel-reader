{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightNovel Reader",
  "version": "0.3.1",
  "identifier": "com.tauri-app.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LightNovel Reader",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LightNovel Reader",
    "copyright": "© 2026 LightNovel Reader. AGPL-3.0.",
    "category": "Entertainment",
    "shortDescription": "本地优先的开源轻小说阅读器",
    "longDescription": "离线优先、开源免费、无广告的轻小说 / 电子书阅读器：本地 EPUB 书库、标注与 Markdown 导出、阅读进度持久化。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
