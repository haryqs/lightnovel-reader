{
  "name": "reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:arch": "node scripts/check-arch.mjs",
    "check:memory": "node scripts/check-dev-memory.mjs",
    "check:protocol": "node scripts/check-protocol-freeze.mjs",
    "check:wasm": "node scripts/check-wasm-artifacts.mjs",
    "check:release-trust": "node scripts/check-release-trust.mjs",
    "test:release-trust": "node scripts/test-release-trust.mjs",
    "check:project": "node scripts/check-arch.mjs && node scripts/check-dev-memory.mjs && node scripts/check-protocol-freeze.mjs && node scripts/check-wasm-artifacts.mjs",
    "build:wasm": "node scripts/build-reading-core-wasm.mjs",
    "dev:note": "node scripts/dev-note.mjs",
    "smoke:fixtures": "powershell -ExecutionPolicy Bypass -File scripts/new-smoke-epubs.ps1",
    "smoke:tauri": "node scripts/tauri-webdriver-smoke.mjs",
    "smoke:p0": "node scripts/tauri-p0-smoke.mjs",
    "smoke:p1": "node scripts/tauri-p1-smoke.mjs",
    "smoke:remote-link": "node scripts/tauri-remote-link-smoke.mjs",
    "smoke:opds": "node scripts/tauri-opds-smoke.mjs",
    "smoke:plugin-source": "node scripts/tauri-plugin-source-smoke.mjs",
    "smoke:plugin-repo": "node scripts/tauri-plugin-repository-smoke.mjs",
    "smoke:plugin-repository-fixtures": "node scripts/new-smoke-plugin-repository.mjs",
    "smoke:plugin-repository-signature": "node scripts/smoke-plugin-repository-signature.mjs",
    "prepare:plugin-repository-release": "node scripts/prepare-plugin-repository-release.mjs",
    "sign:plugin-repository": "node scripts/sign-plugin-repository.mjs",
    "verify:plugin-repository-release": "node scripts/verify-plugin-repository-release.mjs",
    "prepare:updater-release": "node scripts/prepare-updater-release.mjs",
    "test:prepare-updater-release": "node scripts/test-prepare-updater-release.mjs",
    "prepackage:beta": "node scripts/check-release-trust.mjs",
    "package:beta": "powershell -ExecutionPolicy Bypass -File scripts/package-beta.ps1",
    "preinstaller:web": "node scripts/check-release-trust.mjs",
    "installer:web": "powershell -ExecutionPolicy Bypass -File scripts/build-web-installer.ps1",
    "release:build": "node scripts/check-release-trust.mjs && tauri build",
    "release:build:updater": "node scripts/check-release-trust.mjs && tauri build --bundles nsis",
    "build": "node scripts/check-arch.mjs && node scripts/check-protocol-freeze.mjs && node scripts/check-wasm-artifacts.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
