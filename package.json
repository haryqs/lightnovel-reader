{
  "name": "reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:arch": "node scripts/check-arch.mjs",
    "check:memory": "node scripts/check-dev-memory.mjs",
    "check:protocol": "node scripts/check-protocol-freeze.mjs",
    "check:project": "node scripts/check-arch.mjs && node scripts/check-dev-memory.mjs && node scripts/check-protocol-freeze.mjs",
    "dev:note": "node scripts/dev-note.mjs",
    "smoke:fixtures": "powershell -ExecutionPolicy Bypass -File scripts/new-smoke-epubs.ps1",
    "smoke:tauri": "node scripts/tauri-webdriver-smoke.mjs",
    "smoke:p0": "node scripts/tauri-p0-smoke.mjs",
    "smoke:p1": "node scripts/tauri-p1-smoke.mjs",
    "smoke:remote-link": "node scripts/tauri-remote-link-smoke.mjs",
    "smoke:opds": "node scripts/tauri-opds-smoke.mjs",
    "package:beta": "powershell -ExecutionPolicy Bypass -File scripts/package-beta.ps1",
    "installer:web": "powershell -ExecutionPolicy Bypass -File scripts/build-web-installer.ps1",
    "build": "node scripts/check-arch.mjs && node scripts/check-protocol-freeze.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
